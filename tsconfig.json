{
	"compilerOptions": {
		"exactOptionalPropertyTypes": true,
		"moduleResolution": "bundler",
		"noUncheckedIndexedAccess": true,
		"outDir": "bin",
		"removeComments": true,
		"rootDir": "src",
		"sourceMap": false,
		"strict": true,
		"target": "es2022",
		"types": ["node"]
	},
	"include": ["src/**/*.ts"]
}
