{
	"author": "r37r0m0d3l",
	"bin": {
		"hardwired-install-typescript": "bin/install.js",
		"hardwired-uninstall-typescript": "bin/uninstall.js"
	},
	"bugs": {
		"url": "https://github.com/r37r0m0d3l/hardwired_skill_typescript/issues"
	},
	"description": "Opinionated TypeScript rules designed to be reused as a shared skill or injected directly into your project's AI instruction files.",
	"devDependencies": {
		"@types/node": "^26.1.0",
		"markdownlint-cli2": "^0.12.1",
		"prettier": "^3.8.4",
		"tar": "^7.5.16",
		"typescript": "^7.0.2"
	},
	"engineStrict": true,
	"engines": {
		"node": ">=22.18.0"
	},
	"files": [
		"README.md",
		"bin/",
		"principles.md",
		"rulebook.yaml",
		"rules/",
		"templates/"
	],
	"homepage": "https://github.com/r37r0m0d3l/hardwired_skill_typescript#readme",
	"keywords": [
		"agents",
		"ai",
		"ai-coding",
		"ai-governance",
		"ai-instructions",
		"ai-skills",
		"best-practices",
		"claude",
		"claude-code",
		"code-style",
		"codex",
		"coding-standards",
		"copilot",
		"copilot-instructions",
		"cursor",
		"cursorrules",
		"developer-experience",
		"immutability",
		"linting",
		"llm",
		"rules",
		"skill",
		"type-safety",
		"typescript",
		"windsurf"
	],
	"license": "MIT",
	"name": "hardwired-skill-typescript",
	"private": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/r37r0m0d3l/hardwired_skill_typescript.git"
	},
	"scripts": {
		"build": "tsc",
		"build:docs": "npx downdoc docs/README.adoc -o README.md",
		"format:check": "prettier --check \"rules/**/*.{md,mdc}\" \"src/**/*.ts\" \"*.md\"",
		"format:write": "prettier --write \"rules/**/*.{md,mdc}\" \"src/**/*.ts\" \"*.md\"",
		"lint:md": "markdownlint-cli2 \"rules/**/*.md\" \"*.md\"",
		"test": "npm run test:all",
		"test:agentdir": "node test/agentdir/agentdir.spec.js",
		"test:agentsmd": "node test/agentsmd/agentsmd.spec.js",
		"test:all": "node test/all/all.spec.js",
		"test:claudemd": "node test/claudemd/claudemd.spec.js",
		"test:cleanup": "node test/utils/cleanup-runner.mjs",
		"test:copilotdir": "node test/copilotdir/copilotdir.spec.js",
		"test:cursordir": "node test/cursordir/cursordir.spec.js",
		"test:cursormd": "node test/cursormd/cursormd.spec.js"
	},
	"type": "module",
	"version": "1.0.9"
}
